<?xml version="1.0"?>
<mavlink>
    <version>3</version>
    <dialect>1</dialect>

    <messages>
        <!-- 12003: 地面站发给机巢的指令 -->
        <message id="12003" name="DRONE_NEST_COMMAND">
            <description>Command sent to drone nest</description>
            <field type="uint16_t" name="ordinary_order">Ordinary order: 0x1101 door open, 0x1102 door close, 0x1103 door stop, 0x0F01 charge start, 0x0F02 charge stop, 0x1401 clamp tighten, 0x1402 clamp release, 0x1403 clamp stop, 0x0A01 estop, 0x0A02 estop release, 0x0A04 initialize, 0x0A05 fault recovery, 0x0A06 light on, 0x0A07 light off, 0x0B01 drone power on, 0x0B02 drone power off</field>
            <field type="uint8_t" name="takeoff_land_order">Auto takeoff/land order: 0x01 takeoff start, 0x02 takeoff abort, 0x04 landing abort</field>
        </message>

        <!-- 12004: 机巢状态回复（27字节）-->
        <message id="12004" name="DRONE_NEST_RESPONSE">
            <description>Status response from drone nest</description>
            <field type="uint16_t" name="ac_temp">AC temperature (×10 °C)</field>
            <field type="uint16_t" name="nest_temperature">Nest temperature (×10 °C)</field>
            <field type="uint16_t" name="env_temperature">Environment temperature (×10 °C)</field>
            <field type="uint16_t" name="wind_direction">Wind direction (×100 °)</field>
            <field type="uint16_t" name="wind_speed">Wind speed (×10 m/s)</field>
            <field type="uint16_t" name="atmospheric_pressure">Atmospheric pressure (×10 kPa)</field>
            <field type="uint16_t" name="rainfall">Rainfall (×10 mm/m²)</field>
            <field type="uint16_t" name="charge_volt">Charge voltage (×100 V)</field>
            <field type="uint16_t" name="charge_current">Charge current (×100 A)</field>
            <field type="uint16_t" name="error_code">Error code</field>
            <field type="uint16_t" name="boolstate1">Boolean state 1: bit0 nest heartbeat, bit1 drone heartbeat, bit2 PLC heartbeat, bit3 estop, bit4 charging, bit5 calibrating, bit6 ready, bit7 init, bit8 busy, bit9 fault, bit10 R-axis zero, bit11 headlight off</field>
            <field type="uint16_t" name="boolstate2">Boolean state 2</field>
            <field type="uint8_t" name="clamp_state">Clamp state</field>
            <field type="uint8_t" name="gate_state">Gate state</field>
            <field type="uint8_t" name="landing_light_state">Landing light state</field>
        </message>

        <!-- 12005: 指令执行回复（8字节）-->
        <message id="12005" name="DRONE_NEST_ORDER_RESPONSE">
            <description>Order execution response</description>
            <field type="uint32_t" name="ordinary_order_response">Ordinary order response</field>
            <field type="uint32_t" name="takeoff_land_order_response">Takeoff/land order response</field>
        </message>
    </messages>
</mavlink>
